# ==================
# ====== APP =======
# ==================
API_KEY=123456
PORT=3000

# ==================
# ==== Database ====
# ==================
MONGO_URI=mongodb://127.0.0.1:27017/SERVER

# ==================
# ====== Auth ======
# ==================
JWT_SECRET=
JWT_EXPIRES_IN=60m
REFRESH_TOKEN_EXPIRES_DAYS=30
JWT_ISSUER=starter-kit-api
JWT_AUDIENCE=starter-kit-client

# ==================
# === Cloudinary ===
# ==================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==================
# ===== Client =====
# ==================
CLIENT_URL=http://localhost:5173

# ==================
# ===== Redis ======
# ==================
REDIS_URL=redis://127.0.0.1:6379

# ==================
# ====== Mail ======
# ==================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=""
MAIL_FROM=

# ==================
# ====== Time ======
# ==================
APP_TIMEZONE=Africa/Cairo

# ==================
# === OpenRouter ===
# ==================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=30000
OPENROUTER_APP_NAME=Node Express Starter Kit
OPENROUTER_APP_URL=http://localhost:3000